# Application Environment Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/bookmyshow_dev

# In-Memory Cache & Lock Store (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Configuration
# Generate secure 256-bit keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging & Observability (trace, debug, info, warn, error, fatal)
LOG_LEVEL=debug

# Razorpay Payment Gateway Configuration
# Obtain credentials from Razorpay Dashboard (Settings -> API Keys & Webhooks)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere
RAZORPAY_CURRENCY=INR
PAYMENT_ORDER_EXPIRY_MINUTES=15

# Notification System Configuration
# Providers: mock, smtp, resend
EMAIL_PROVIDER=mock
EMAIL_FROM_NAME=BookMyShow Support
EMAIL_FROM_ADDRESS=no-reply@bookmyshow.example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# SMS Providers: mock, twilio, fast2sms
SMS_PROVIDER=mock
SMS_SENDER_ID=BMSIND
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
FAST2SMS_API_KEY=

# WhatsApp Providers: mock, whatsapp_cloud
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

NOTIFICATION_MAX_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=5

