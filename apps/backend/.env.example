# ==============================================================================
# Enterprise BookMyShow Clone - Environment Variables Specification
# Copy this file to .env and populate production values before deployment.
# ==============================================================================

# Core Application Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Infrastructure Security & Proxies
# Set TRUST_PROXY=1 when deployed behind AWS ALB, Cloudflare, Nginx, or Google Cloud Run
TRUST_PROXY=0
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Documentation & Telemetry
ENABLE_SWAGGER=true
METRICS_ENABLED=true
INTERNAL_METRICS_TOKEN=bms_internal_metrics_secret_token_12345

# Database Configuration (MongoDB)
# In production, use MongoDB Atlas with TLS: mongodb+srv://<user>:<password>@cluster0.mongodb.net/bms_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bookmyshow_dev

# Cache & Lock Store (Redis)
# In production, use managed Redis with TLS: rediss://:<password>@prod-redis.internal:6379
REDIS_URL=redis://localhost:6379

# Cryptographic Keys (Mandatory >= 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Structured Logging (trace, debug, info, warn, error, fatal)
LOG_LEVEL=debug

# Seat Locking & Concurrency Controls
SEAT_LOCK_TTL_SECONDS=300
MAX_SEATS_PER_LOCK=10
MAX_LOCK_RENEWALS=2

# Booking Engine & Fiscal Controls
BOOKING_PAYMENT_WINDOW_SECONDS=300
DEFAULT_CONVENIENCE_FEE=30.00
DEFAULT_TAX_PERCENT=18.00
BOOKING_CANCELLATION_CUTOFF_HOURS=2

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere
RAZORPAY_CURRENCY=INR
PAYMENT_ORDER_EXPIRY_MINUTES=15

# Notification System Configuration
# Providers: mock, smtp, resend
EMAIL_PROVIDER=mock
EMAIL_FROM_NAME=BookMyShow Support
EMAIL_FROM_ADDRESS=no-reply@bookmyshow.example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# SMS Providers: mock, twilio, fast2sms
SMS_PROVIDER=mock
SMS_SENDER_ID=BMSIND
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
FAST2SMS_API_KEY=

# WhatsApp Providers: mock, whatsapp_cloud
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Background Queue & Reliability
NOTIFICATION_MAX_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=5
