# ==============================================================================
# Enterprise BookMyShow Clone - Root Environment Variables Specification
# ==============================================================================

# Core Runtime Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# Client Application URLs
CUSTOMER_APP_URL=http://localhost:5173
THEATRE_DASHBOARD_URL=http://localhost:5174
ADMIN_DASHBOARD_URL=http://localhost:5175

# Proxy & Cookie Security
TRUST_PROXY=0
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Feature Toggles & Metrics
ENABLE_SWAGGER=true
METRICS_ENABLED=true
INTERNAL_METRICS_TOKEN=bms_internal_metrics_secret_token_12345

# Database & In-Memory Distributed Caches
MONGODB_URI=mongodb://localhost:27017/bookmyshow_dev
REDIS_URL=redis://localhost:6379

# Cryptographic Token Secrets (Must be 32+ characters minimum)
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging Level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=debug

# Temporary Seat Reservation & Locking
SEAT_LOCK_TTL_SECONDS=300
MAX_SEATS_PER_LOCK=10
MAX_LOCK_RENEWALS=2

# Booking Fees & Cutoff Policies
BOOKING_PAYMENT_WINDOW_SECONDS=300
DEFAULT_CONVENIENCE_FEE=30.00
DEFAULT_TAX_PERCENT=18.00
BOOKING_CANCELLATION_CUTOFF_HOURS=2

# Razorpay Payment Gateway (Test Mode Credentials)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere
RAZORPAY_CURRENCY=INR
PAYMENT_ORDER_EXPIRY_MINUTES=15

# Omnichannel Notifications - Email (Mock, SMTP, or Resend)
EMAIL_PROVIDER=mock
EMAIL_FROM_NAME=BookMyShow Support
EMAIL_FROM_ADDRESS=no-reply@bookmyshow.example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Omnichannel Notifications - SMS (Mock, Fast2SMS, or Twilio)
SMS_PROVIDER=mock
SMS_SENDER_ID=BMSIND
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
FAST2SMS_API_KEY=

# Omnichannel Notifications - WhatsApp Business Cloud API
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Notification Queue Retries & Backoff
NOTIFICATION_MAX_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=5

# Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=admin@bookmyshow.clone
SUPER_ADMIN_PHONE=9876543210
SUPER_ADMIN_PASSWORD=SuperAdmin@Secure2026!
SUPER_ADMIN_NAME=Platform Super Admin
